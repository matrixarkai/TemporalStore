#%Module1.0
##
## GCC modulefile
##
proc ModulesHelp { } {
    global version

    puts stderr "\tSets up environment for GCC v$version"
}

module-whatis "sets up environment for GCC v8.3.0"

set version 8.3.0
set root    /usr/local/cpp_tools/gcc-8.3.0

prepend-path INFOPATH        $root/share/info
prepend-path LD_LIBRARY_PATH $root/lib64:$root/lib
prepend-path MANPATH         $root/share/man
prepend-path PATH            $root/bin

setenv CC  $root/bin/gcc
setenv CXX $root/bin/g++

conflict gcc