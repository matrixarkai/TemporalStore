        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__NODE__\" \"__PLUGIN_ROOT__/scripts/temporalstore_hook_launcher.mjs\" Stop",
            "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__NODE__\" \"__PLUGIN_ROOT__/scripts/temporalstore_hook_launcher.mjs\" PreCompact",
