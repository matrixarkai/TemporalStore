# TemporalStore Claude Code context-hook configuration.
#
# Source this (or copy the values into your shell profile) before starting Claude
# Code so tools/matrixark_claude_hook.sh picks them up. Claude's memory is scoped
# to its own agent/tenant, kept distinct from Codex.

# Backend for the Claude hook:
#   auto   (default) -> python parity pipeline when the rust proxy is built, else rust
#   python           -> matrixark_agent_hook.py --agent claude (same engine as Codex)
#   rust             -> self-contained offline crate bin codex_context_hook
MATRIXARK_CLAUDE_HOOK_BACKEND=auto

# Agent identity + scope (kept separate from the codex tenant).
TEMPORALSTORE_AGENT_NAME=claude
MATRIXARK_AGENT_NAME=claude
MATRIXARK_ACCOUNT_ID=acct_claude
MATRIXARK_TENANT_ID=tenant_claude
MATRIXARK_USER_ID=local_user
MATRIXARK_TEAM=agent
TEMPORALSTORE_AGENT_PROJECT=TemporalStore

# Python (parity) backend: local rust proxy, no metaserver required.
MATRIXARK_MCP_BACKEND=temporalstore-rust
MATRIXARK_LOCAL_MODE=no-metaserver
MATRIXARK_TEMPORALSTORE_METASERVER=local
MATRIXARK_TEMPORALSTORE_RUST_ROOT=/tmp/temporalstore-claude-hook-store
MATRIXARK_RUST_PROXY_ASYNC_STORAGE=true
MATRIXARK_HOOK_STORAGE_ROUTE=shared_store_async
MATRIXARK_TEST_RUST_PROXY=/root/src/github-services/TemporalStore/target/release/matrixark_rust_proxy
MATRIXARK_STORAGE_PREFIX=matrixark:claude-hook

# Rust (offline) backend storage roots.
TEMPORALSTORE_RUST_CLAUDE_HOOK_ROOT=/tmp/temporalstore-rust-claude-hook
TEMPORALSTORE_RUST_CLAUDE_EVENT_LOG=/tmp/temporalstore-rust-claude-hook.jsonl

# Retrieval policy.
MATRIXARK_MAX_CONTEXT_TOKENS=10000
MATRIXARK_HOOK_ADDITIONAL_CONTEXT_CHAR_LIMIT=40000

# Fail-open: a hook error never blocks the Claude Code turn (set to 0 to surface errors).
MATRIXARK_HOOK_FAIL_OPEN=1
