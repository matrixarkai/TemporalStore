# TemporalStore agent hook configuration.

TEMPORALSTORE_AGENT_MODE=dry-run
TEMPORALSTORE_AGENT_NAME=codex
TEMPORALSTORE_AGENT_PROJECT=TemporalStore

# Backend endpoints and local paths.
TEMPORALSTORE_AGENT_ENDPOINT=http://127.0.0.1:18080
TEMPORALSTORE_REPO=/opt/github-services/TemporalStore
TEMPORALSTORE_WSL_REPO=/opt/github-services/TemporalStore
TEMPORALSTORE_PYTHON=python3
TEMPORALSTORE_WSL_DISTRO=

# MatrixArk / TemporalStore serving config.
TEMPORALSTORE_METASERVER=127.0.0.1:18000
TEMPORALSTORE_NAMESPACE=deploy_ns
TEMPORALSTORE_TABLE=deploy_table
TEMPORALSTORE_LIBRARY=output-ubuntu22/release/sdk/lib/libbcache2.so
MATRIXARK_STORAGE_PREFIX=matrixark:agent-hook
MATRIXARK_ACCOUNT_ID=acct_local
MATRIXARK_TENANT_ID=tenant_codex
MATRIXARK_USER_ID=local_user
MATRIXARK_TEAM=agent

# Retrieval policy.
MATRIXARK_MAX_CONTEXT_TOKENS=10000
MATRIXARK_HOOK_ADDITIONAL_CONTEXT_CHAR_LIMIT=40000
MATRIXARK_REQUEST_TIMEOUT_MS=90000
MATRIXARK_IO_TIMEOUT_MS=90000
MATRIXARK_SESSION_COMMIT_THRESHOLD=20
MATRIXARK_IDLE_COMMIT_TIMEOUT_MS=300000
