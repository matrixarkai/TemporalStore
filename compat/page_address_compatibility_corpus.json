{
  "schema_version": 1,
  "name": "temporalstore-page-address-compatibility-corpus",
  "description": "Shared C++/Rust corpus for canonical PageAddress compatibility, range lookup, split, compaction, tombstone, cold scan, and restart index rebuild behavior.",
  "address_fields": [
    "shard_id",
    "zone_id",
    "segment_id",
    "page_id",
    "offset",
    "length",
    "generation"
  ],
  "block_address_fields": [
    "shard_id",
    "zone_id",
    "block_id",
    "offset",
    "length",
    "checksum"
  ],
  "addresses": [
    {
      "id": "a2",
      "shard_id": 1,
      "zone_id": 10,
      "segment_id": 3,
      "page_id": 2,
      "offset": 64,
      "length": 32,
      "generation": 1,
      "checksum": "sha256:a2"
    },
    {
      "id": "a1",
      "shard_id": 1,
      "zone_id": 10,
      "segment_id": 3,
      "page_id": 1,
      "offset": 0,
      "length": 64,
      "generation": 1,
      "checksum": "sha256:a1"
    },
    {
      "id": "b1",
      "shard_id": 1,
      "zone_id": 11,
      "segment_id": 1,
      "page_id": 1,
      "offset": 0,
      "length": 48,
      "generation": 2,
      "checksum": "sha256:b1"
    },
    {
      "id": "c1",
      "shard_id": 2,
      "zone_id": 1,
      "segment_id": 1,
      "page_id": 1,
      "offset": 0,
      "length": 16,
      "generation": 1,
      "checksum": "sha256:c1"
    }
  ],
  "block_addresses": [
    {
      "id": "ba1",
      "shard_id": 1,
      "zone_id": 10,
      "block_id": 3,
      "offset": 0,
      "length": 96,
      "checksum": "sha256:block-a"
    },
    {
      "id": "ba2",
      "shard_id": 1,
      "zone_id": 11,
      "block_id": 1,
      "offset": 128,
      "length": 48,
      "checksum": "sha256:block-b"
    },
    {
      "id": "ba3",
      "shard_id": 2,
      "zone_id": 1,
      "block_id": 1,
      "offset": 0,
      "length": 16,
      "checksum": "sha256:block-c"
    }
  ],
  "expected_stable_order": [
    "a1",
    "a2",
    "b1",
    "c1"
  ],
  "expected_block_stable_order": [
    "ba1",
    "ba2",
    "ba3"
  ],
  "timestamp_page_index": {
    "logical_key": "feature:tenant=77:user=9:object=storage-feature",
    "entries": [
      {
        "start_ms": 1000,
        "end_ms": 1019,
        "address_id": "a1"
      },
      {
        "start_ms": 1020,
        "end_ms": 1039,
        "address_id": "a2"
      },
      {
        "start_ms": 1040,
        "end_ms": 1059,
        "address_id": "b1"
      }
    ],
    "queries": [
      {
        "name": "middle_range",
        "start_ms": 1010,
        "end_ms": 1045,
        "expected_address_ids": [
          "a1",
          "a2",
          "b1"
        ]
      },
      {
        "name": "exact_second_page",
        "start_ms": 1020,
        "end_ms": 1039,
        "expected_address_ids": [
          "a2"
        ]
      }
    ]
  },
  "page_split_case": {
    "name": "target_bytes_splits_timestamp_ordered_pages",
    "target_page_bytes": 32,
    "records": [
      {
        "timestamp_ms": 2000,
        "encoded_bytes": 14,
        "value": "p0"
      },
      {
        "timestamp_ms": 2010,
        "encoded_bytes": 14,
        "value": "p1"
      },
      {
        "timestamp_ms": 2020,
        "encoded_bytes": 14,
        "value": "p2"
      },
      {
        "timestamp_ms": 2030,
        "encoded_bytes": 14,
        "value": "p3"
      }
    ],
    "expected_pages": [
      {
        "start_ms": 2000,
        "end_ms": 2010,
        "record_count": 2
      },
      {
        "start_ms": 2020,
        "end_ms": 2030,
        "record_count": 2
      }
    ]
  },
  "compaction_rewrite_case": {
    "name": "rewrite_preserves_logical_records_and_advances_generation",
    "before": [
      {
        "address_id": "a1",
        "records": [
          {
            "timestamp_ms": 1000,
            "value": "v1000"
          },
          {
            "timestamp_ms": 1010,
            "value": "v1010"
          }
        ]
      },
      {
        "address_id": "a2",
        "records": [
          {
            "timestamp_ms": 1020,
            "value": "v1020"
          }
        ]
      }
    ],
    "after": [
      {
        "address": {
          "id": "compact1",
          "shard_id": 1,
          "zone_id": 12,
          "segment_id": 1,
          "page_id": 1,
          "offset": 0,
          "length": 96,
          "generation": 2,
          "checksum": "sha256:compact1"
        },
        "records": [
          {
            "timestamp_ms": 1000,
            "value": "v1000"
          },
          {
            "timestamp_ms": 1010,
            "value": "v1010"
          },
          {
            "timestamp_ms": 1020,
            "value": "v1020"
          }
        ]
      }
    ],
    "stale_address_ids": [
      "a1",
      "a2"
    ]
  },
  "tombstone_case": {
    "name": "tombstone_skips_stale_records",
    "records": [
      {
        "timestamp_ms": 3000,
        "value": "live-before"
      },
      {
        "timestamp_ms": 3010,
        "value": "deleted",
        "tombstone": {
          "deleted_at_ms": 9000,
          "reason": "ttl_expired"
        }
      },
      {
        "timestamp_ms": 3020,
        "value": "live-after"
      }
    ],
    "query": {
      "start_ms": 2990,
      "end_ms": 3030,
      "include_tombstoned": false,
      "expected_values": [
        "live-before",
        "live-after"
      ]
    },
    "debug_replay_query": {
      "start_ms": 2990,
      "end_ms": 3030,
      "include_tombstoned": true,
      "expected_values": [
        "live-before",
        "deleted",
        "live-after"
      ]
    }
  },
  "tombstone_compaction_case": {
    "name": "tombstones_survive_compaction_while_live_records_are_rewritten",
    "before": [
      {
        "timestamp_ms": 4000,
        "value": "live-before-compaction"
      },
      {
        "timestamp_ms": 4010,
        "value": "deleted-before-compaction",
        "tombstone": {
          "deleted_at_ms": 9010,
          "reason": "ttl_expired"
        }
      },
      {
        "timestamp_ms": 4020,
        "value": "live-after-compaction"
      }
    ],
    "after_compaction": {
      "address": {
        "id": "compact2",
        "shard_id": 1,
        "zone_id": 12,
        "segment_id": 2,
        "page_id": 1,
        "offset": 96,
        "length": 96,
        "generation": 3,
        "checksum": "sha256:compact2"
      },
      "records": [
        {
          "timestamp_ms": 4000,
          "value": "live-before-compaction"
        },
        {
          "timestamp_ms": 4020,
          "value": "live-after-compaction"
        }
      ],
      "tombstones": [
        {
          "timestamp_ms": 4010,
          "deleted_at_ms": 9010,
          "reason": "ttl_expired"
        }
      ]
    },
    "normal_query_expected_values": [
      "live-before-compaction",
      "live-after-compaction"
    ],
    "debug_replay_expected_tombstones": [
      4010
    ]
  },
  "stale_generation_case": {
    "name": "stale_generation_addresses_are_ignored_after_compaction",
    "live_generation": 2,
    "live_address_ids": [
      "compact1"
    ],
    "stale_generation": 1,
    "stale_address_ids": [
      "a1",
      "a2"
    ],
    "normal_read_expected_ignored_address_ids": [
      "a1",
      "a2"
    ],
    "debug_replay_can_request_stale_generations": true
  },
  "cold_scan_case": {
    "name": "cold_scan_does_not_warm_serving_cache",
    "timestamp_range": {
      "start_ms": 1000,
      "end_ms": 1059
    },
    "cache_before": {
      "hot_keys": [
        "serving:recent"
      ],
      "admission_count": 7
    },
    "read_options": {
      "no_cache_fill": true,
      "no_promote": true,
      "decode_batch_limit": 2
    },
    "expected_cache_after": {
      "hot_keys": [
        "serving:recent"
      ],
      "admission_count": 7
    },
    "expected_scan": {
      "page_address_ids": [
        "a1",
        "a2",
        "b1"
      ],
      "max_decoded_per_batch": 2
    }
  },
  "restart_rebuild_case": {
    "name": "crash_restart_rebuilds_page_and_block_index",
    "manifest_before_crash": {
      "object_index_entries": [
        {
          "model": "feature",
          "table": "context_events",
          "object_key": "feature:tenant=77:user=9:object=storage-feature",
          "page_address_ids": [
            "a1",
            "a2",
            "b1"
          ]
        }
      ],
      "page_index_entries": [
        {
          "logical_key": "feature:tenant=77:user=9:object=storage-feature",
          "start_ms": 1000,
          "end_ms": 1019,
          "address_id": "a1"
        },
        {
          "logical_key": "feature:tenant=77:user=9:object=storage-feature",
          "start_ms": 1020,
          "end_ms": 1039,
          "address_id": "a2"
        },
        {
          "logical_key": "feature:tenant=77:user=9:object=storage-feature",
          "start_ms": 1040,
          "end_ms": 1059,
          "address_id": "b1"
        }
      ],
      "block_index_entries": [
        {
          "address_id": "a1",
          "block_address_id": "ba1",
          "storage_uri": "local://zone-10/segment-3",
          "checksum": "sha256:a1"
        },
        {
          "address_id": "a2",
          "block_address_id": "ba1",
          "storage_uri": "local://zone-10/segment-3",
          "checksum": "sha256:a2"
        },
        {
          "address_id": "b1",
          "block_address_id": "ba2",
          "storage_uri": "local://zone-11/segment-1",
          "checksum": "sha256:b1"
        }
      ]
    },
    "expected_after_restart": {
      "page_index_entry_count": 3,
      "block_index_entry_count": 3,
      "object_index_entry_count": 1,
      "lookup_query_name": "middle_range",
      "expected_address_ids": [
        "a1",
        "a2",
        "b1"
      ],
      "unreadable_page_refs": 0,
      "checksum_mismatches": 0
    }
  }
}
