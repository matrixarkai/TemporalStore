      "average": "avg",
      "last": "latest"
    },
    "gated_high_cardinality_aggregates": [
      "distinct_count",
      "unique_count",
      "top_k",
      "heavy_hitters",
      "hll",
      "theta_sketch",
      "count_min_sketch",
      "histogram",
      "percentile"
    ],
    "policy": "FeatureAggregate remains inside the Feature capability; public v1 exposes exact serving aggregates only and rejects sketch/high-cardinality aggregate names until mature."
