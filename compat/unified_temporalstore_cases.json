        {
          "name": "common_expire_missing_matches_cpp_not_found",
          "skip_client": true,
          "command": {
            "kind": "common_expire",
            "key": "unified:missing:string",
            "ttl_ms": 1000
          },
          "expect_status": {
            "ok": false,
            "code": "not_found",
            "message": "key not found"
          },
          "expect": {
            "kind": "empty"
          }
        }
      ]
