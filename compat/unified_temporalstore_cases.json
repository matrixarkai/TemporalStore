{
  "schema_version": 1,
  "name": "temporalstore-unified-cpp-rust-corpus",
  "description": "Shared behavioral corpus for validating Rust and C++ TemporalStore implementations with the same ordered operations and expected responses.",
  "cases": [
    {
      "name": "common_string_hash_core",
      "shard_id": 1,
      "steps": [
        {
          "name": "string_set",
          "command": {
            "kind": "string_set",
            "key": "unified:string",
            "value": [118, 49]
          },
          "expect": {
            "kind": "empty"
          }
        },
        {
          "name": "string_get",
          "command": {
            "kind": "string_get",
            "key": "unified:string"
          },
          "expect": {
            "kind": "bytes",
            "value": [118, 49]
          }
        },
        {
          "name": "hash_multi_set",
          "command": {
            "kind": "hash_multi_set",
            "key": "unified:hash",
            "entries": [
              ["field_a", [97]],
              ["field_b", [98]]
            ]
          },
          "expect": {
            "kind": "empty"
          }
        },
        {
          "name": "hash_multi_get",
          "command": {
            "kind": "hash_multi_get",
            "key": "unified:hash",
            "fields": ["field_a", "field_missing", "field_b"]
          },
          "expect": {
            "kind": "values",
            "values": [[97], null, [98]]
          }
        }
      ]
    },
