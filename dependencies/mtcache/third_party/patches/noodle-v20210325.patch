diff --git a/include/noodle/test_util/sync_point.h b/include/noodle/test_util/sync_point.h
index efa46c6..2ebe1a3 100644
--- a/include/noodle/test_util/sync_point.h
+++ b/include/noodle/test_util/sync_point.h
@@ -2,6 +2,10 @@
 //  This source code is licensed under both the GPLv2 (found in the
 //  COPYING file in the root directory) and Apache 2.0 License
 //  (found in the LICENSE.Apache file in the root directory).
+//
+// A facility to reproduce race conditions deterministically in unit tests,
+// adapted from the SyncPoint implementation in Facebook RocksDB codebase:
+//   https://github.com/facebook/rocksdb/blob/master/test_util/sync_point.h
 
 #pragma once
 
@@ -25,6 +29,13 @@
 
 namespace noodle {
 
+// This class provides facility to reproduce race conditions deterministically
+// in unit tests. Developer could specify sync points in the codebase via
+// macros such as NOODLE_TEST_SYNC_POINT, etc. Each sync point represents a
+// position in the execution stream of a thread. In the unit test, 'Happens
+// After' relationship among sync points could be setup via
+// SyncPoint::LoadDependency, to reproduce a desired interleave of threads
+// execution. See the accompanying unit tests for example use cases.
 class SyncPoint {
  public:
   static SyncPoint* GetInstance();
@@ -32,35 +43,61 @@ class SyncPoint {
   SyncPoint() = default;
   NOODLE_NO_COPYING(SyncPoint);
 
+  // A SyncPointPair defines the dependency relationship between two sync
+  // points, where the 'successor' happens after the 'predecessor'.
   struct SyncPointPair {
     std::string predecessor;
     std::string successor;
   };
 
+  // Call once at the beginning of a test to setup the dependency between
+  // sync points.
   void LoadDependency(const std::vector<SyncPointPair>& dependencies);
 
+  // Call once at the beginning of a test to setup the dependency between
+  // sync points and setup markers indicating the successor is only enabled
+  // when it is processed on the same thread as the predecessor. When adding a
+  // marker, it implicitly adds a dependency for the marker pair.
+  //
+  // NOTE: the current implementation can only support no more than one marker
+  // for each sync point.
   void LoadDependencyAndMarkers(const std::vector<SyncPointPair>& dependencies,
                                 const std::vector<SyncPointPair>& markers);
 
+  // Set the callback function for the given sync point. The argument to the
+  // callback is passed through from NOODLE_TEST_SYNC_POINT_CALLBACK(); nullptr
+  // if NOODLE_TEST_SYNC_POINT or NOODLE_TEST_IDX_SYNC_POINT was used.
   void SetCallback(const std::string& point,
                    const std::function<void(void*)>& callback);
 
+  // Clear the callback function for the given sync point.
   void ClearCallback(const std::string& point);
 
+  // Clear all call back functions for all sync points.
   void ClearAllCallbacks();
 
+  // Enable sync point processing (disabled on startup).
   void EnableProcessing();
 
+  // Disable sync point processing.
   void DisableProcessing();
 
+  // Remove the execution trace of all sync points. After this call, all sync
+  // points are considered not hit.
   void ClearTrace();
 
+  // Whether the give sync point has been hit.
   bool IsCleared(const std::string& point);
 
+  // Wait until the given sync point has been hit.
   void WaitCleared(const std::string& point);
 
+  // Clears all dependencies among sync points as well as the.
   void Reset();
 
+  // Trigger a sync point (usually define by one of the NOODLE_TEST_SYNC_POINT
+  // macros): blocking execution until all predecessors are executed, then
+  // call registered callback function with argument `cb_arg`.
   void Process(const std::string& point, void* cb_arg = nullptr);
 
  private:
@@ -71,17 +108,31 @@ class SyncPoint {
   Monitor monitor_;
   std::atomic<bool> enabled_{false};
 
+  // The dependency graph expressed as 'happen-after' relationships.
   std::unordered_map<std::string, std::vector<std::string> > successors_;
+  // The dependency graph expressed as 'happen-before' relationships.
   std::unordered_map<std::string, std::vector<std::string> > predecessors_;
+  // The marker dependency graph expressed as 'happen-after' relationships.
   std::unordered_map<std::string, std::vector<std::string> > markers_;
+  // The callback to invoke for each sync point.
   std::unordered_map<std::string, std::function<void(void*)> > callbacks_;
+  // Mapping from each sync point to the thread task ID that hits its one and
+  // only one marker.
   std::unordered_map<std::string, pid_t> marked_tids_;
+  // The set of sync points that have been hit.
   std::unordered_set<std::string> cleared_points_;
+  // The number of all running callbacks over all sync points.
   int num_callbacks_running_ = 0;
 };
 
 }  // namespace noodle
 
+// Use NOODLE_TEST_SYNC_POINT to specify sync points inside code base.
+// Sync points can have happens-after dependency on other sync points,
+// configured at runtime via SyncPoint::LoadDependency. This could be
+// utilized to re-produce race conditions between threads.
+// See TransactionLogIteratorRace in db_test.cc for an example use case.
+// TEST_SYNC_POINT is no op in release build.
 #define NOODLE_TEST_SYNC_POINT(x) noodle::SyncPoint::GetInstance()->Process(x)
 #define NOODLE_TEST_IDX_SYNC_POINT(x, index) \
   noodle::SyncPoint::GetInstance()->Process(x + std::to_string(index))
-- 
