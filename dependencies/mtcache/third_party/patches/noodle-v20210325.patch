+++ noodle-v20210325.new/CMakeLists.txt	2021-11-26 17:09:08.291962505 +0800
@@ -0,0 +1,99 @@
+cmake_minimum_required(VERSION 3.10.0)
+
+project("noodle" C CXX)
+
+set(CXX_STANDARD 17)
+set(CXX_STANDARD_REQUIRED ON)
+
+# includes
+set(CMAKE_MODULE_PATH
+  "${HSAP_THIRDPARTY_HOME}/cmake"
+  ${CMAKE_MODULE_PATH})
+
+# package information
+set(PACKAGE_NAME      "noodle")
+set(PACKAGE_VERSION   "v20210325")
+set(PACKAGE_STRING    "${PACKAGE_NAME} ${PACKAGE_VERSION}")
+set(PACKAGE_TARNAME   "${PACKAGE_NAME}-${PACKAGE_VERSION}")
+
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "_build")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "_build")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "_build")
+
+message(STATUS "CMAKE_CURRENT_SOURCE_DIR: " ${CMAKE_CURRENT_SOURCE_DIR})
+message(STATUS "CMAKE_INCLUDE_PATH: " ${CMAKE_INCLUDE_PATH})
+message(STATUS "CMAKE_LIBRARY_PATH: " ${CMAKE_LIBRARY_PATH})
+message(STATUS "CMAKE_PROGRAM_PATH: " ${CMAKE_PROGRAM_PATH})
+message(STATUS "CMAKE_MODULE_PATH: ${CMAKE_MODULE_PATH}")
+message(STATUS "CMAKE_INSTALL_PREFIX: ${CMAKE_INSTALL_PREFIX}")
+
+set(NOODLE_HOME ${CMAKE_CURRENT_SOURCE_DIR})
+
+set(CMAKE_EXE_LINKER_FLAGS "-static-libstdc++ -static-libgcc -no-pie")
+
+add_compile_options(-Wall)
+add_compile_options(-Werror)
+add_compile_options(-Wno-unused-parameter)
+add_compile_options(-Wno-error=parentheses)
+add_compile_options(-Wno-error=unused-variable)
+add_compile_options(-Wno-error=unused-function)
+add_compile_options(-Wno-error=sign-compare)
+add_compile_options(-Wno-constant-conversion)
+add_compile_options(-Wno-unused-command-line-argument)
+add_compile_options("-Wno-shadow")
+add_compile_options("-fPIC")
+
+include(HSAPFunctions)
+
+include_directories(SYSTEM ${CMAKE_INSTALL_PREFIX}/include)
+include_directories(AFTER ${NOODLE_HOME}/include)
+include_directories(AFTER ${NOODLE_HOME}/src)
+
+add_compile_definitions(NOODLE_BUILD_YEAR=2021)
+
+auto_sources(files "*.cc" "RECURSE" "${NOODLE_HOME}/src")
+
+REMOVE_MATCHES_FROM_LISTS(files
+  MATCHES
+   "/test/"
+   "console_application.cc"
+   "systemd_service.cc"
+)
+
+find_package(Threads REQUIRED)
+find_package(Gflags REQUIRED)
+find_package(Glog 0.3.3 REQUIRED)
+find_package(LZ4 1.9.2 REQUIRED)
+find_package(Zstd 1.4.5 REQUIRED)
+find_package(Snappy 1.1.6 REQUIRED)
+find_package(OpenSSL 1.0.1 REQUIRED)
+find_package(ZLIB 1.2.8 REQUIRED)
+
+find_package(XxHash 0.6.5 REQUIRED)
+
+add_library(noodle_base OBJECT
+  ${files}
+)
+
+add_library(noodle
+  $<TARGET_OBJECTS:noodle_base>
+)
+
+target_link_libraries(noodle
+  glog::glog
+  gflags
+  ${LZ4_LIBRARY}
+  ${SNAPPY_LIBRARY}
+  ${ZSTD_LIBRARY}
+  ${XXHASH_LIBRARY}
+)
+
+add_custom_target(
+    clean-all
+    DEPENDS ${CLEAN_TARGETS}
+)
+
+include(GNUInstallDirs)
+
+install(DIRECTORY include/noodle COMPONENT devel DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
+install(FILES _build/libnoodle.a COMPONENT devel DESTINATION "${CMAKE_INSTALL_LIBDIR}")
